// Prisma Schema for Asset_MaintanceTool - Phase 1 Minimal Core
// Multi-tenant SaaS with PostgreSQL RLS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  IT_ASSET_MANAGER
  FIELD_TECHNICIAN
  EMPLOYEE
  AUDITOR
  READ_ONLY
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  IN_REPAIR
  ON_LOAN
  RETIRED
  DISPOSED
}

enum AssetEventType {
  CHECK_OUT
  CHECK_IN
  MAINTENANCE_START
  MAINTENANCE_COMPLETE
  RESERVE
  LEASE
  LEASE_RETURN
  MOVE
  DISPOSE
  RETIRE
  TAG_CHANGE
  CUSTODIAN_CHANGE
  STATUS_CHANGE
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  CALIBRATION
  INSPECTION
}

enum AuditStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum AuditItemStatus {
  FOUND
  MISSING
  MISMATCHED
  DAMAGED
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  PENDING_RENEWAL
  TERMINATED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
  WEBHOOK
  SLACK
  TEAMS
}

enum WebhookEvent {
  ASSET_CREATED
  ASSET_UPDATED
  ASSET_DELETED
  ASSET_CHECKED_OUT
  ASSET_CHECKED_IN
  MAINTENANCE_STARTED
  MAINTENANCE_COMPLETED
  AUDIT_COMPLETED
  WARRANTY_EXPIRING
  AGENT_OFFLINE
}

// ─── Core Models ───

model Tenant {
  id                String    @id @default(uuid())
  name              String
  slug              String    @unique
  domain            String?   @unique
  logo_url          String?
  primary_color     String?   @default("#2563EB")
  timezone          String    @default("UTC")
  currency          String    @default("USD")
  date_format       String    @default("MM/DD/YYYY")
  time_format       String    @default("12h")
  plan              String    @default("free")
  max_assets        Int       @default(1000)
  max_users         Int       @default(50)
  max_storage_gb    Int       @default(10)
  settings          Json      @default("{}")
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  @@index([slug])
  @@index([domain])
}

model User {
  id              String      @id @default(uuid())
  tenant_id       String
  email           String
  password_hash   String?
  first_name      String
  last_name       String
  phone           String?
  title           String?
  avatar_url      String?
  timezone        String      @default("UTC")
  date_format     String      @default("MM/DD/YYYY")
  time_format     String      @default("12h")
  language        String      @default("en")
  role            UserRole    @default(EMPLOYEE)
  status          UserStatus  @default(ACTIVE)
  mfa_enabled     Boolean     @default(false)
  mfa_secret      String?
  backup_codes    String[]    @default([])
  last_login_at   DateTime?
  last_activity_at DateTime?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at      DateTime?
  invited_by      String?
  invited_at      DateTime?

  @@unique([tenant_id, email])
  @@index([tenant_id, status])
  @@index([tenant_id, role])
}

model Session {
  id           String   @id @default(uuid())
  user_id      String
  token_hash   String   @unique
  ip_address   String?
  user_agent   String?
  device_info  Json?
  expires_at   DateTime
  created_at   DateTime @default(now())
  last_used_at DateTime @default(now())
  revoked_at   DateTime?

  @@index([user_id, expires_at])
  @@index([token_hash])
}

model UserGroup {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String
  description String?
  color       String?  @default("#6366F1")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, name])
}

model UserGroupMember {
  id        String     @id @default(uuid())
  user_id   String
  group_id  String
  role      String     @default("member")
  joined_at DateTime   @default(now())

  @@unique([user_id, group_id])
}

model ApiKey {
  id           String   @id @default(uuid())
  tenant_id    String
  name         String
  key_hash     String   @unique
  key_prefix   String
  scopes       String[]
  owner_id     String?
  last_used_at DateTime?
  expires_at   DateTime?
  revoked_at   DateTime?
  created_at   DateTime @default(now())
  last_used_by String?

  @@index([tenant_id])
  @@index([key_hash])
}

model Site {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String
  code        String
  address     String?
  city        String?
  state       String?
  country     String?  @default("US")
  postal_code String?
  timezone    String   @default("UTC")
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, code])
  @@index([tenant_id, is_active])
}

model Location {
  id          String   @id @default(uuid())
  tenant_id   String
  site_id     String
  name        String
  code        String
  description String?
  parent_id   String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, site_id, code])
  @@index([tenant_id, site_id])
  @@index([parent_id])
}

model Category {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String
  code        String
  description String?
  color       String?  @default("#3B82F6")
  icon        String?  @default("box")
  parent_id   String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, code])
  @@index([tenant_id, parent_id])
}

model Department {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String
  code        String
  description String?
  cost_center String?
  manager_id  String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, code])
  @@index([tenant_id])
}

model CustomField {
  id            String   @id @default(uuid())
  tenant_id     String
  name          String
  label         String
  type          String
  entity_type   String
  category_id   String?
  options       Json?
  validation    Json?
  is_required   Boolean  @default(false)
  is_filterable Boolean  @default(true)
  is_searchable Boolean  @default(true)
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([tenant_id, entity_type, name])
  @@index([tenant_id, entity_type])
}

model AssetCustomFieldValue {
  id              String         @id @default(uuid())
  asset_id        String
  custom_field_id String
  value_text      String?
  value_number    Float?
  value_boolean   Boolean?
  value_date      DateTime?
  value_json      Json?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  @@unique([asset_id, custom_field_id])
  @@index([asset_id])
  @@index([custom_field_id])
}

// ─── Asset Core ───

model Asset {
  id                String   @id @default(uuid())
  tenant_id         String
  asset_tag         String
  normalized_tag    String
  serial_number     String?
  qr_code_data      String?
  barcode_data      String?

  make              String?
  model             String?
  category_id       String?

  site_id           String?
  location_id       String?
  department_id     String?
  custodian_user_id String?

  status            AssetStatus @default(IN_STOCK)
  condition         String?    @default("Good")
  purchase_date     DateTime?
  purchase_cost     Decimal?   @db.Decimal(12, 2)
  currency          String     @default("USD")
  warranty_expires  DateTime?
  vendor_id         String?

  asset_tag_counter Int        @default(0)
  created_by_id     String
  updated_by_id     String?
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt
  deleted_at        DateTime?

  @@unique([tenant_id, normalized_tag])
  @@index([tenant_id, status])
  @@index([tenant_id, site_id])
  @@index([tenant_id, location_id])
  @@index([tenant_id, category_id])
  @@index([tenant_id, custodian_user_id])
  @@index([tenant_id, serial_number])
  @@index([tenant_id, created_at])
  @@index([tenant_id, deleted_at])
}

model AssetTag {
  id        String  @id @default(uuid())
  asset_id  String
  tag       String
  created_at DateTime @default(now())
  created_by String?

  @@unique([asset_id, tag])
  @@index([tag])
}

model AssetImage {
  id        String   @id @default(uuid())
  asset_id  String
  url       String
  filename  String
  mime_type String
  size      Int
  width     Int?
  height    Int?
  is_primary Boolean @default(false)
  caption   String?
  created_at DateTime @default(now())
  created_by String?

  @@index([asset_id, is_primary])
}

model Document {
  id          String   @id @default(uuid())
  asset_id    String?
  tenant_id   String
  filename    String
  mime_type   String
  size        Int
  url         String
  sha256      String
  title       String?
  description String?
  tags        String[]
  uploaded_by String
  uploaded_at DateTime @default(now())
  scanned     Boolean  @default(false)
  scan_result String?

  @@index([asset_id])
  @@index([tenant_id, uploaded_at])
}

// ─── Asset Events / Lifecycle ───

model AssetEvent {
  id              String        @id @default(uuid())
  asset_id        String
  tenant_id       String
  event_type      AssetEventType
  description     String?
  metadata        Json?
  performed_by_id String
  occurred_at     DateTime      @default(now())
  created_at      DateTime      @default(now())

  @@index([asset_id, occurred_at])
  @@index([tenant_id, event_type, occurred_at])
}

// ─── Maintenance ───

model MaintenanceWorkOrder {
  id              String            @id @default(uuid())
  tenant_id       String
  wo_number       String
  asset_id        String
  type            MaintenanceType
  status          MaintenanceStatus @default(OPEN)
  priority        Int               @default(3)

  title           String
  description     String?
  problem_description String?
  root_cause      String?
  resolution      String?

  technician_id   String?
  assigned_at     DateTime?
  started_at      DateTime?
  completed_at    DateTime?
  due_date        DateTime?

  labor_hours     Decimal?   @db.Decimal(6, 2)
  labor_rate      Decimal?   @db.Decimal(10, 2)
  parts_cost      Decimal?   @db.Decimal(12, 2)
  total_cost      Decimal?   @db.Decimal(12, 2)
  downtime_hours  Decimal?   @db.Decimal(6, 2)

  condition_before String?
  condition_after  String?

  is_recurring    Boolean  @default(false)
  recurrence_rule String?
  parent_wo_id    String?

  created_by_id   String
  assigned_by_id  String?
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  deleted_at      DateTime?

  @@unique([tenant_id, wo_number])
  @@index([tenant_id, status])
  @@index([tenant_id, asset_id])
  @@index([tenant_id, technician_id])
  @@index([tenant_id, due_date])
}

model MaintenanceTask {
  id          String   @id @default(uuid())
  wo_id       String
  title       String
  description String?
  is_completed Boolean  @default(false)
  completed_at DateTime?
  completed_by String?
  order       Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([wo_id, order])
}

model MaintenancePart {
  id          String   @id @default(uuid())
  wo_id       String
  part_name   String
  part_number String?
  quantity    Int      @default(1)
  unit_cost   Decimal? @db.Decimal(10, 2)
  total_cost  Decimal? @db.Decimal(10, 2)
  source      String?
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([wo_id])
}

model MaintenanceLabor {
  id          String   @id @default(uuid())
  wo_id       String
  technician_id String
  date        DateTime @default(now())
  hours       Decimal  @db.Decimal(4, 2)
  rate        Decimal? @db.Decimal(10, 2)
  description String?
  created_at  DateTime @default(now())

  @@index([wo_id])
  @@index([technician_id])
}

model MaintenanceAttachment {
  id        String   @id @default(uuid())
  wo_id     String
  url       String
  filename  String
  mime_type String
  size      Int
  uploaded_by String
  created_at DateTime @default(now())

  @@index([wo_id])
}

model MaintenanceNote {
  id        String   @id @default(uuid())
  wo_id     String
  author_id String
  content   String
  is_internal Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([wo_id, created_at])
}

model MaintenanceHistory {
  id          String   @id @default(uuid())
  wo_id       String
  field_name  String
  old_value   String?
  new_value   String?
  changed_by_id String
  changed_at  DateTime @default(now())

  @@index([wo_id, changed_at])
}

// ─── Reservations ───

model Reservation {
  id              String   @id @default(uuid())
  tenant_id       String
  asset_id        String
  requester_id    String
  approver_id     String?
  start_at        DateTime
  end_at          DateTime
  purpose         String?
  status          String   @default("PENDING")
  approved_at     DateTime?
  rejected_at     DateTime?
  rejection_reason String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([tenant_id, asset_id, start_at])
  @@index([tenant_id, requester_id, status])
  @@index([tenant_id, status])
}

// ─── Audits ───

model AuditSession {
  id              String       @id @default(uuid())
  tenant_id       String
  name            String
  scope_type      String
  scope_id        String?
  scope_name      String?
  status          AuditStatus  @default(SCHEDULED)

  start_at        DateTime?
  end_at          DateTime?
  due_at          DateTime?
  timezone        String       @default("UTC")

  lead_auditor_id String?

  total_assets    Int          @default(0)
  scanned_count   Int          @default(0)
  found_count     Int          @default(0)
  missing_count   Int          @default(0)
  mismatched_count Int         @default(0)
  damaged_count   Int          @default(0)

  notify_assignees Boolean     @default(true)
  require_signature Boolean    @default(false)
  require_photo    Boolean     @default(false)
  offline_enabled  Boolean     @default(true)

  created_by_id   String
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  completed_at    DateTime?

  @@index([tenant_id, status])
  @@index([tenant_id, due_at])
  @@index([tenant_id, lead_auditor_id])
}

model AuditSessionItem {
  id              String           @id @default(uuid())
  session_id      String
  asset_id        String
  expected_location_id String?
  scanned_location_id String?
  status          AuditItemStatus  @default(MISSING)
  scanned_at      DateTime?
  scanned_by_id   String?
  notes           String?
  photo_url       String?
  signature_url   String?
  discrepancy_id  String?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  @@unique([session_id, asset_id])
  @@index([session_id, status])
  @@index([asset_id])
}

model AuditDiscrepancy {
  id              String   @id @default(uuid())
  session_id      String
  asset_id        String
  type            String
  severity        String   @default("MEDIUM")
  status          String   @default("OPEN")
  suggested_match_id String?
  resolution      String?
  resolved_by_id  String?
  resolved_at     DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([session_id, status])
  @@index([asset_id])
}

// ─── Contracts & Warranties ───

model Contract {
  id              String         @id @default(uuid())
  tenant_id       String
  name            String
  contract_number String         @unique
  type            String
  status          ContractStatus @default(ACTIVE)
  vendor_id       String?

  value           Decimal?       @db.Decimal(12, 2)
  currency        String         @default("USD")
  billing_cycle   String?
  auto_renew      Boolean        @default(false)

  start_date      DateTime
  end_date        DateTime?
  renewal_date    DateTime?
  notice_period_days Int        @default(30)

  terms           String?
  sla_terms       String?

  owner_id        String?
  created_by_id   String
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  deleted_at      DateTime?

  @@index([tenant_id, status])
  @@index([tenant_id, vendor_id])
  @@index([tenant_id, end_date])
  @@index([tenant_id, renewal_date])
}

model ContractReminder {
  id           String   @id @default(uuid())
  contract_id  String
  type         String
  trigger_at   DateTime
  sent_at      DateTime?
  recipient_ids String[]
  channel      NotificationChannel @default(EMAIL)
  status       String   @default("PENDING")
  created_at   DateTime @default(now())

  @@index([contract_id, trigger_at])
  @@index([trigger_at, status])
}

// ─── Notifications & Webhooks ───

model Notification {
  id            String              @id @default(uuid())
  tenant_id     String
  user_id       String?
  type          String
  title         String
  message       String
  data          Json?
  channel       NotificationChannel @default(IN_APP)
  status        String              @default("UNREAD")
  read_at       DateTime?
  related_type  String?
  related_id    String?
  created_at    DateTime            @default(now())

  @@index([tenant_id, user_id, status])
  @@index([tenant_id, created_at])
  @@index([related_type, related_id])
}

model Webhook {
  id              String   @id @default(uuid())
  tenant_id       String
  name            String
  url             String
  secret          String
  events          String[]
  is_active       Boolean  @default(true)
  retry_policy    Json?
  timeout_ms      Int      @default(30000)
  last_triggered  DateTime?
  last_status     String?
  created_by_id   String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([tenant_id, is_active])
}

model WebhookDeliveryLog {
  id            String   @id @default(uuid())
  webhook_id    String
  event         String
  payload       Json
  status_code   Int?
  response_body String?
  latency_ms    Int
  attempt       Int      @default(1)
  error         String?
  created_at    DateTime @default(now())

  @@index([webhook_id, created_at])
  @@index([created_at])
}

// ─── Agent Management ───

model AgentEnrollment {
  id              String   @id @default(uuid())
  tenant_id       String
  asset_id        String?
  enrollment_token String  @unique
  hostname        String?
  os              String?
  os_version      String?
  agent_version   String?
  status          String   @default("PENDING")
  last_seen       DateTime?
  last_ip         String?
  enrolled_at     DateTime @default(now())
  enrolled_by_id  String?
  revoked_at      DateTime?
  revoked_by_id   String?

  sync_interval_seconds Int   @default(900)
  data_categories       String[] @default(["hardware", "software", "network", "security"])
  privacy_mode          Boolean @default(true)
  auto_update           Boolean @default(true)

  @@index([tenant_id, status])
  @@index([tenant_id, asset_id])
  @@index([enrollment_token])
}

model AgentHeartbeat {
  id              String   @id @default(uuid())
  enrollment_id   String
  received_at     DateTime @default(now())
  ip_address      String?
  data            Json?

  @@index([enrollment_id, received_at])
}

model AgentSoftware {
  id              String   @id @default(uuid())
  enrollment_id   String
  name            String
  version         String?
  publisher       String?
  install_date    DateTime?
  install_path    String?
  size            BigInt?
  usage_percent   Float?
  last_used       DateTime?
  category        String?
  is_authorized   Boolean  @default(true)
  detected_at     DateTime @default(now())
  last_seen       DateTime @default(now())

  @@index([enrollment_id, name])
  @@unique([enrollment_id, name, version])
}

// ─── Settings & Audit ───

model Setting {
  id        String   @id @default(uuid())
  tenant_id String
  key       String
  value     Json
  scope     String   @default("tenant")
  user_id   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, scope, key, user_id])
}

model AuditLog {
  id            String   @id @default(uuid())
  tenant_id     String
  user_id       String?
  action        String
  resource_type String
  resource_id   String?
  old_values    Json?
  new_values    Json?
  ip_address    String?
  user_agent    String?
  metadata      Json?
  hash          String
  previous_hash String?
  created_at    DateTime @default(now())

  @@index([tenant_id, created_at])
  @@index([tenant_id, user_id, created_at])
  @@index([tenant_id, resource_type, resource_id])
  @@index([action, created_at])
}