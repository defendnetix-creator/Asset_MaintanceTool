# Asset Maintenance Tool - Production Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=production
FRONTEND_URL=https://your-domain.com
API_URL=https://api.your-domain.com

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_USER=assetmt
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=assetmt

# Connection string (used by Prisma)
DATABASE_URL=postgresql://assetmt:CHANGE_ME_SECURE_PASSWORD@postgres:5432/assetmt?schema=public

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://redis:6379

# =============================================================================
# AUTHENTICATION (JWT)
# =============================================================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie settings
COOKIE_DOMAIN=your-domain.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# =============================================================================
# STORAGE (MinIO/S3)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_SECURE_MINIO_PASSWORD
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_BUCKET=assetmt-assets

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@your-domain.com
SMTP_FROM_NAME=Asset Maintenance Tool

# =============================================================================
# MONITORING
# =============================================================================
LOG_LEVEL=info
SENTRY_DSN=
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_PWA=true
ENABLE_OFFLINE_SYNC=true
ENABLE_AUDIT_SCANNING=true
ENABLE_REALTIME_UPDATES=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# BACKUP
# =============================================================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=assetmt-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=