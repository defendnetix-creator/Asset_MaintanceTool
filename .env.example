# Asset Maintenance Tool - Production Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=production
FRONTEND_URL=https://your-domain.com
API_URL=https://api.your-domain.com

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_USER=assetmt
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=assetmt

# Connection string (used by Prisma)
DATABASE_URL=postgresql://assetmt:CHANGE_ME_SECURE_PASSWORD@postgres:5432/assetmt?schema=public

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://redis:6379

# =============================================================================
# AUTHENTICATION (JWT)
# ============================================================================
# Generate with: openssl genrsa -out keys/private.pem 2048 && openssl rsa -in keys/private.pem -pubout -out keys/public.pem
# 
# DEVELOPMENT KEYS - COMPROMISED: 
# The keys in ./backend/keys/ were generated for development only 
# and must NOT be used in production. They are committed to git 
# for convenience but should be replaced with fresh keys for 
# any deployment.
#
# For production deployment, generate new RS256 keypairs and 
# provide them through environment variables or mounted files.
#
# Generate fresh keypairs:
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
#   openssl genrsa -out keys/refresh-private.pem 2048
#   openssl rsa -in keys/refresh-private.pem -pubout -out keys/refresh-public.pem
#
# Provide via environment:
#   JWT_PRIVATE_KEY=$(cat keys/private.pem)
#   JWT_REFRESH_PRIVATE_KEY=$(cat keys/refresh-private.pem)
#
# Or mount at runtime:
#   - ./keys/private.pem:/app/keys/private.pem:ro
#   - ./keys/refresh-private.pem:/app/keys/refresh-private.pem:ro
#
# The backend reads these from environment variables at runtime.
#
# Do NOT commit private keys to version control.
#
JWT_PRIVATE_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_REFRESH_PRIVATE_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# Cookie settings
COOKIE_DOMAIN=your-domain.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# =============================================================================
# STORAGE (MinIO/S3)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_SECURE_MINIO_PASSWORD
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_BUCKET=assetmt-assets

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@your-domain.com
SMTP_FROM_NAME=Asset Maintenance Tool

# =============================================================================
# MONITORING
# =============================================================================
LOG_LEVEL=info
SENTRY_DSN=
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_PWA=true
ENABLE_OFFLINE_SYNC=true
ENABLE_AUDIT_SCANNING=true
ENABLE_REALTIME_UPDATES=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# BACKUP
# =============================================================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=assetmt-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=