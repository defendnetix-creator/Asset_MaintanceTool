# Asset Maintenance Tool - Environment Variables Template
# Copy this file to .env and fill in the values

# ==========================================
# Database
# ==========================================
POSTGRES_PASSWORD=your-secure-postgres-password-here

# ==========================================
# Redis
# ==========================================
# No password needed for local development

# ==========================================
# MinIO (S3-compatible storage)
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-secure-minio-password-here

# ==========================================
# JWT Keys (Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
# ==========================================
JWT_PRIVATE_KEY=your-2048-bit-rsa-private-key-here
JWT_PUBLIC_KEY=your-2048-bit-rsa-public-key-here
JWT_REFRESH_PRIVATE_KEY=your-refresh-private-key-here
JWT_REFRESH_PUBLIC_KEY=your-refresh-public-key-here

# ==========================================
# Cookie Secret (Generate with: openssl rand -base64 32)
# ==========================================
COOKIE_SECRET=your-secure-cookie-secret-here

# ==========================================
# Caddy / SSL
# ==========================================
ACME_EMAIL=admin@yourdomain.com

# ==========================================
# Grafana
# ==========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password-here

# ==========================================
# SMTP (Optional - for email notifications)
# ==========================================
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=Asset Maintenance Tool <noreply@yourdomain.com>

# ==========================================
# Sentry (Optional - for error tracking)
# ==========================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==========================================
# Feature Flags
# ==========================================
ENABLE_SSO=false
ENABLE_PWA=true
ENABLE_AUDIT_LOG=true